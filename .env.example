# =====================================================================
# COLLEGE ARTS FESTIVAL MANAGEMENT SYSTEM (KALOLSAVAM)
# Environment Configuration
# =====================================================================

# NEXT_PUBLIC_SUPABASE_URL: Your Supabase Project URL
# Example: https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Your Supabase Public Anon API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Supabase secret service key for server-side elevated admin actions
SUPABASE_SERVICE_ROLE_KEY=

# When Supabase credentials are left empty during initial development,
# the app seamlessly activates its built-in resilient offline Data Provider
# populated with authentic Kalolsavam festival data.

